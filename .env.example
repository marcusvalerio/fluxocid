# Copie para .env.local (não commitado) e ajuste conforme o ambiente.

# URL base do Worker da API (worker/). Em dev local com `wrangler dev` (worker/README ou
# docs/DEPLOYMENT.md), o padrão já funciona sem configurar nada:
VITE_API_BASE_URL=http://localhost:8787

# Em produção, aponte para o Worker publicado, ex.:
# VITE_API_BASE_URL=https://fluxocit-api.<seu-subdominio>.workers.dev
